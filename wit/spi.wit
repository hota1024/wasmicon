package wasmicon:hal@0.1.0;

/// SPI master.
/// Chip select (CS) is not handled by this interface: the guest drives the CS and DC
/// pins directly through `gpio`, which suits devices with a DC line such as the ILI9341.
/// Bit order is fixed to MSB first and the word width to 8 bits.
interface spi {
    use types.{error-code};

    /// CPOL/CPHA combination.
    enum mode {
        /// CPOL=0, CPHA=0
        mode0,
        /// CPOL=0, CPHA=1
        mode1,
        /// CPOL=1, CPHA=0
        mode2,
        /// CPOL=1, CPHA=1
        mode3,
    }

    /// An SPI bus.
    /// `index` is the platform-specific bus number.
    /// The SCK/MOSI/MISO pin assignment comes from the host-side board configuration.
    resource bus {
        /// Initializes and opens the bus. `frequency-hz` is rounded to the nearest
        /// value the host supports.
        open: static func(index: u32, frequency-hz: u32, mode: mode) -> result<bus, error-code>;

        /// Sends `data` and discards the received bytes. The hot path of display drawing.
        write: func(data: list<u8>) -> result<_, error-code>;

        /// Full-duplex transfer: sends `data` and returns the same number of received bytes.
        /// In the Wasmicon ABI the returned `list<u8>` is written into a buffer the
        /// caller provides.
        transfer: func(data: list<u8>) -> result<list<u8>, error-code>;
    }
}
