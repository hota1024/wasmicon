package wasmicon:hal@0.1.0;

/// General-purpose digital I/O.
interface gpio {
    use types.{error-code};

    enum level {
        low,
        high,
    }

    enum pin-mode {
        /// Input without a pull resistor.
        input,
        /// Input with pull-up.
        input-pull-up,
        /// Input with pull-down.
        input-pull-down,
        /// Push-pull output.
        output,
        /// Open-drain output.
        output-open-drain,
    }

    /// A single GPIO pin.
    /// `index` is the platform-specific GPIO number (ESP32-S3: GPIOn, RP2040: GPn).
    resource pin {
        /// Opens the pin in the given mode. Fails with `busy` if it is already open.
        open: static func(index: u32, mode: pin-mode) -> result<pin, error-code>;

        /// Changes the pin mode.
        set-mode: func(mode: pin-mode) -> result<_, error-code>;

        /// Reads the current input level. Works in output mode too (returns the output value).
        read: func() -> result<level, error-code>;

        /// Sets the output level. Fails with `invalid-argument` in input mode.
        write: func(level: level) -> result<_, error-code>;

        /// Inverts the output level.
        toggle: func() -> result<_, error-code>;
    }
}
