package wasmicon:app@0.1.0;

/// Wasmicon 上で動くアプリケーションの world。
/// Wasmicon は Component Model を使わないため、この world は
/// 「ゲストモジュールが import してよい関数の集合」と「ゲストが export すべき関数」を
/// 記述するための IDL としてのみ使う。
///
/// world を `wasmicon:hal` から独立させてあるのは、`wasmicon:device` が
/// `wasmicon:hal` の型を `use` するため（abi-spec §11.2）。
/// hal に world を置いたまま device を import すると依存が循環する。
world app {
    import wasmicon:hal/types@0.1.0;
    import wasmicon:hal/gpio@0.1.0;
    import wasmicon:hal/i2c@0.1.0;
    import wasmicon:hal/spi@0.1.0;
    import wasmicon:hal/time@0.1.0;
    import wasmicon:hal/log@0.1.0;
    import wasmicon:hal/board@0.1.0;

    /// エントリポイント。ホストがインスタンス化後に 1 回呼ぶ。
    /// 戻ると、ホストはインスタンスを破棄してよい。
    export run: func();
}
