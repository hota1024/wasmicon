package wasmicon:hal@0.1.0;

/// The world of an application that runs on Wasmicon.
/// Wasmicon does not use the Component Model, so this world serves only as an IDL
/// that lists the functions a guest module may import and the functions it must export.
world app {
    import types;
    import gpio;
    import i2c;
    import spi;
    import time;
    import log;
    import board;

    /// Entry point. The host calls it once after instantiation.
    /// When it returns, the host may destroy the instance.
    export run: func();
}
