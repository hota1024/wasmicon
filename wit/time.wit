package wasmicon:hal@0.1.0;

/// Monotonic time and blocking delays.
interface time {
    /// Returns the monotonic time in microseconds since boot. The u64 does not wrap in practice.
    now-us: func() -> u64;

    /// Blocks for `ms` milliseconds.
    sleep-ms: func(ms: u32);

    /// Blocks for `us` microseconds. The accuracy depends on the host's timer resolution.
    sleep-us: func(us: u32);
}
