/// Wasmicon HAL 共通型。
/// 全インターフェースはこのパッケージの error-code を共有する。
package wasmicon:hal@0.1.0;

interface types {
    /// HAL 共通のエラーコード。
    /// Wasmicon ABI では、result<T, error-code> を返す関数は
    /// 単一の i32 を返し、0 = 成功、n > 0 = (discriminant + 1) を意味する。
    enum error-code {
        /// 引数が不正（範囲外の pin 番号、長さ 0 の転送など）
        invalid-argument,
        /// ハンドルが無効、または既に drop されている
        invalid-handle,
        /// 対象のペリフェラル・ピンが既に使用中
        busy,
        /// タイムアウト
        timeout,
        /// I2C: デバイスから NACK が返った
        nack,
        /// バスエラーなど、その他の I/O エラー
        io,
        /// このプラットフォームではサポートされない操作・設定
        unsupported,
        /// ホスト側のリソース不足（ハンドル上限など）
        out-of-memory,
    }
}
