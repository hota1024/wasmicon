/// Common types of the Wasmicon HAL.
/// Every interface shares the `error-code` of this package.
package wasmicon:hal@0.1.0;

interface types {
    /// Error code shared by the whole HAL.
    /// In the Wasmicon ABI a function that returns `result<T, error-code>`
    /// returns a single i32: 0 = success, n > 0 = discriminant + 1.
    enum error-code {
        /// Invalid argument (pin number out of range, zero-length transfer, ...).
        invalid-argument,
        /// The handle is invalid or has already been dropped.
        invalid-handle,
        /// The peripheral or pin is already in use.
        busy,
        /// The operation timed out.
        timeout,
        /// I2C: the device answered with NACK.
        nack,
        /// Other I/O error, such as a bus error.
        io,
        /// The operation or setting is not supported on this platform.
        unsupported,
        /// The host ran out of resources (for example the handle limit).
        out-of-memory,
    }
}
