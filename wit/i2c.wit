package wasmicon:hal@0.1.0;

/// I2C master.
interface i2c {
    use types.{error-code};

    enum speed {
        /// 100 kHz
        standard,
        /// 400 kHz
        fast,
        /// 1 MHz
        fast-plus,
    }

    /// An I2C bus.
    /// `index` is the platform-specific bus number (ESP32-S3: I2C0/1, RP2040: i2c0/1).
    /// The SDA/SCL pin assignment comes from the host-side board configuration
    /// (docs/abi-spec.md §8).
    resource bus {
        /// Initializes and opens the bus.
        open: static func(index: u32, speed: speed) -> result<bus, error-code>;

        /// Writes `data` to the device at 7-bit address `address` (START ... STOP).
        write: func(address: u16, data: list<u8>) -> result<_, error-code>;

        /// Reads `len` bytes from the device at 7-bit address `address` (START ... STOP).
        /// In the Wasmicon ABI the returned `list<u8>` is written into a buffer the
        /// caller provides.
        read: func(address: u16, len: u32) -> result<list<u8>, error-code>;

        /// Writes `data`, then reads `len` bytes after a repeated START (STOP only at the end).
        /// The usual pattern for reading a register.
        write-read: func(address: u16, data: list<u8>, len: u32) -> result<list<u8>, error-code>;
    }
}
