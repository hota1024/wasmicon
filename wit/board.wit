package wasmicon:hal@0.1.0;

/// Board-specific pin assignment, looked up by role name.
/// Lets the same Wasm binary run on several boards
/// (docs/app-workflow.md §3.9, docs/abi-spec.md §8).
interface board {
    use types.{error-code};

    /// Looks up the GPIO number of a role name.
    /// Returns `unsupported` if the board has no assignment for the role.
    ///
    /// Role names are not a firmware vocabulary; they are a contract between the app
    /// and its wiring. A role name starts with a lowercase letter and is at most
    /// 16 characters of a-z, 0-9 and `-`. The assignment comes from the wiring table
    /// in the device's config slot (docs/abi-spec.md §8).
    pin-by-role: func(role: string) -> result<u32, error-code>;
}
