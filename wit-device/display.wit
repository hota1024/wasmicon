package wasmicon:device@0.1.0;

/// A pixel display that the host drives (docs/device-layer.md §4).
/// The host owns the panel: its bus, initialization, orientation, scale and any frame
/// buffer. Sizes and rectangles are in the display's pixels as the guest sees them,
/// after the configured orientation and scale.
/// The guest only draws rectangles; text and images are drawn by the guest.
interface display {
    use wasmicon:hal/types@0.1.0.{error-code};

    /// How pixels are encoded in `write-rect` and `fill-rect`.
    enum pixel-format {
        /// 16 bits per pixel, 5-6-5, high byte first.
        rgb565,
        /// 8 bits per pixel, an index into the palette set by `set-palette`.
        indexed8,
    }

    /// A display.
    /// `index` is the board's display number. The backend behind it comes from the
    /// board configuration in the device's config slot.
    resource screen {
        /// Opens the display.
        /// Returns `unsupported` if the board has no display at `index`, and `busy` if it
        /// is already open.
        open: static func(index: u32) -> result<screen, error-code>;

        /// Width in pixels, after the configured orientation and scale. 0 for an invalid
        /// handle.
        width: func() -> u32;

        /// Height in pixels, after the configured orientation and scale. 0 for an invalid
        /// handle.
        height: func() -> u32;

        /// The pixel format that `write-rect` and `fill-rect` take. `rgb565` (0) for an
        /// invalid handle.
        format: func() -> pixel-format;

        /// Fills a rectangle with one color in the pixel format: for `rgb565`, a value
        /// up to 0xffff; for `indexed8`, a palette index up to 255.
        /// Returns `invalid-argument` if the rectangle is empty or leaves the screen, or
        /// if `color` does not fit the format; nothing is drawn then.
        fill-rect: func(x: u32, y: u32, w: u32, h: u32, color: u32) -> result<_, error-code>;

        /// Writes `w * h` pixels, row by row, into a rectangle: two bytes each for
        /// `rgb565`, one byte each for `indexed8`.
        /// Returns `invalid-argument` if the rectangle is empty or leaves the screen, or
        /// if `pixels` is not exactly `w * h` pixels long; nothing is drawn then.
        write-rect: func(x: u32, y: u32, w: u32, h: u32, pixels: list<u8>) -> result<_, error-code>;

        /// Sets a 256-entry palette and switches the screen to `indexed8`.
        /// From here on `format` returns `indexed8`, `write-rect` takes one byte per
        /// pixel and `fill-rect` takes an index. `colors` is 256 RGB565 values, high
        /// byte first. The palette is applied when pixels are written: calling this
        /// again replaces it for later writes, and the pixels already on the screen
        /// keep their colors. There is no way back to `rgb565` but dropping the screen
        /// and opening it again.
        /// Returns `invalid-argument` if `colors` is not exactly 512 bytes long;
        /// nothing changes then.
        set-palette: func(colors: list<u8>) -> result<_, error-code>;

        /// Makes everything drawn so far visible.
        /// Call it after drawing: a backend with a frame buffer may show nothing until
        /// then. A backend that draws straight to the panel returns at once.
        present: func() -> result<_, error-code>;
    }
}
